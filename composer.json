{
    "name": "larabergcms/larabergcms",
    "description": "Gutenberg-style content management for Laravel, built on van-ons/laraberg. Installable CRUD, media upload and Blade views.",
    "keywords": [
        "laravel",
        "cms",
        "gutenberg",
        "laraberg",
        "block-editor",
        "blog"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "van-ons/laraberg": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "LarabergCms\\LarabergCms\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LarabergCms\\LarabergCms\\LarabergCmsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}